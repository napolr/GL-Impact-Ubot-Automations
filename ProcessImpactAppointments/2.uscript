clear all data
comment("===========================================")
comment("=== GLOBAL INIT ===")
comment("===========================================")
set(#testMode,"true","Global")
set(#testName,"NAPOLEON RUSS","Global")
set(#calendlyBase,"https://calendly.com/napoleonruss13/ncp","Global")
set(#scheduleUrl,"https://mobile.impact.ailife.com/Home/Index","Global")
clear list(%virtualAppointments)
clear list(%seenLeadIds)
clear list(%dayDates)
clear list(%dayBlocks)
clear list(%apptBlocks)
clear list(%parts)
clear list(%nameParts)
set(#booked,0,"Global")
set(#failed,0,"Global")
comment("===========================================")
comment("=== PHASE 1: NAVIGATE DIRECTLY TO SCHEDULE ===")
comment("===========================================")
ui check box("Test mode - only NAPOLEON RUSS",#testMode)
navigate(#scheduleUrl,"Wait")
wait(3)
comment("=== Click the My Schedule button ===")
comment("=== Replace this selector with the actual one from Element Selector ===")
click(<id="myScheduleButton">,"Left Click","No")
wait(3)
comment("=== Wait for the schedule container to load ===")
wait for element(<id="menucontainer">,30,"")
comment("===========================================")
comment("=== SCRAPE CALENDAR ROWS ===")
comment("===========================================")
set(#diagText,$scrape attribute(<id="menucontainer">,"outerhtml"),"Global")
save to file("C:\\ubot\\ubotSees.txt",#diagText)
alert("UBot sees {$text length(#diagText)} characters")
comment("=== Your existing calendar scraping logic goes here ===")
comment("=== This should populate %virtualAppointments with row data ===")
comment("=== Each item should contain: LeadId|Name|ApptType|ApptDateTime ===")
ScrapeCalendar()
alert("Scraped {$list total(%virtualAppointments)} appointments")
comment("===========================================")
comment("=== PHASE 2: PROCESS EACH LEAD ===")
comment("===========================================")
loop while($comparison($list total(%virtualAppointments),">",0)) {
    comment("=== Get first item and remove it from list ===")
    set(#currentRow,$list item(%virtualAppointments,0),"Global")
    remove from list(%virtualAppointments,0)
    comment("=== Parse the row data (adjust delimiter to match your format) ===")
    set(#leadId,$first part(#currentRow, "|"),"Global")
    set(#leadName,$next part(#currentRow, "|"),"Global")
    set(#apptType,$next part(#currentRow, "|"),"Global")
    set(#apptDateTime,$next part(#currentRow, "|"),"Global")
    comment("=== Skip if test mode and name doesn't match ===")
    if($both($comparison(#testMode,"=","true"),$comparison(#leadName,"=",#testName))) {
        then {
            comment("=== Navigate to lead detail page ===")
            set(#leadDetailUrl,"https://mobile.impact.ailife.com/Lead/Detail?LeadId={#leadId}","Global")
            navigate(#leadDetailUrl,"Wait")
            wait(3)
            comment("=== Scrape contact information ===")
            if($contains(#apptType,"Virtual")) {
                then {
                    comment("=== Virtual appointment logic ===")
                    set(#encodedName,$replace(#leadName," ","%20"),"Global")
                    set(#calendlyUrl,"{#calendlyBase}?name={#encodedName}&email={#leadEmail}&a1=Virtual","Global")
                    navigate(#calendlyUrl,"Wait")
                    wait(5)
                    increment(#booked)
                    save to file("C:\\\\ubot\\\\booked_leads.txt","Booked: {#leadName} - {#apptDateTime}")
                }
                else {
      comment("=== Callback appointment logic ===")
        save to file("C:\\ubot\\callback_leads.txt", "Callback: {#leadName} - {#apptDateTime} - {#leadPhone}", "Append")
                }
            }
            comment("=== Replace these selectors with actual ones from Element Selector ===")
            set(#leadEmail,$scrape attribute(<id="leadEmail">,"innertext"),"Global")
            set(#leadPhone,$scrape attribute(<id="leadPhone">,"innertext"),"Global")
            set(#leadAddress,$scrape attribute(<id="leadAddress">,"innertext"),"Global")
            comment("=== Determine appointment type ===")
            comment("=== Return to schedule for next iteration ===")
            navigate(#scheduleUrl,"Wait")
            wait(2)
            click(<id="myScheduleButton">,"Left Click","No")
            wait(2)
        }
    }
}
alert("Done. Booked: {#booked}, Failed: {#failed}")
