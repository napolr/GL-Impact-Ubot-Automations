define getTodayMarker {
    comment("=== Scrape today's date ===")
    set(#rawDate,$date,"Local")
    comment("=== Split on '/' to get month, day, year-time ===")
    clear list(%dateParts)
    add list to list(%dateParts,$list from text(#rawDate,"/"),"Delete","Local")
    set(#monthNum,$trim($list item(%dateParts,0)),"Local")
    set(#dayNum,$trim($list item(%dateParts,1)),"Local")
    set(#yearNum,$trim($list item(%dateParts,2)),"Local")
    comment("=== Split the year part on space to strip the time ===")
    clear list(%yearParts)
    add list to list(%yearParts,$list from text(#yearNum," "),"Delete","Local")
    set(#yearNum,$trim($list item(%yearParts,0)),"Local")
    set(#yearNum,$substring(#yearNum,0,4),"Local")
    comment("=== Build the month abbreviation list ===")
    clear list(%months)
    add list to list(%months,$list from text("Jan,Feb,Mar,Apr,May,Jun,Jul,Aug,Sep,Oct,Nov,Dec",","),"Delete","Local")
    comment("=== Look up the month abbreviation (0-indexed) ===")
    set(#monthIdx,$subtract(#monthNum,1),"Local")
    set(#monthAbbr,$list item(%months,#monthIdx),"Local")
    comment("=== Build today's date string in the page's format ===")
    set(#todayStr,"{#monthAbbr} {#dayNum} {#yearNum}","Local")
    comment("=== Build the full marker as it appears in pageData ===")
    set(#todayMarker,"Send Text on {#todayStr}","Global")
    return(#todayMarker)
}
