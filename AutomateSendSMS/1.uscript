define IsDetailPage {
    set(#headerText,$scrape attribute(<class="container-fluid pgname">,"innertext"),"Local")
    set(#headerTextLowerCase,$change text casing($trim(#headerText),"Lower Case"),"Local")
    if($contains(#headerTextLowerCase,"detail")) {
        then {
            set(#onDetailPage,"true","Global")
        }
        else {
            set(#onDetailPage,"false","Global")
        }
    }
    return(#onDetailPage)
}
define WaitForDetailPage(#loopCount) {
    if($comparison(#loopCount,"=","")) {
        then {
            set(#loopCount,60,"Local")
        }
    }
    set(#attempts,0,"Local")
    set(#done,"false","Local")
    loop(#loopCount) {
        increment(#attempts)
        wait(1)
        set(#done,$IsDetailPage(),"Local")
        if($comparison(#done,"=","true")) {
            then {
                break()
            }
        }
    }
    if($comparison(#done,"=","false")) {
        then {
            alert("Waited {#attempts} seconds - Detail Page Not Found")
        }
    }
    return(#done)
}
