comment("=====================================================")
comment("=== NAVIGATION MODULE ===")
comment("=====================================================")
comment("--- Navigate to the last record in the list (bottom-to-top prep) ---")
define ScrollToLastRecord {
    set(#reachedEnd,"No","Global")
    loop while($comparison(#reachedEnd,"=","No")) {
        UpdateCounterFromPage()
        if($both($comparison(#counterLeft,"=",#counterRight),$not($comparison(#counterLeft,"=","")))) {
            then {
                log("Reached last record (counter {#counterLeft}/{#counterRight})")
                set(#reachedEnd,"Yes","Global")
            }
            else {
                if($exists(<onclick=w"*/Lead/MoveNext*">)) {
                    then {
                        log("Moving to next record to reach bottom...")
                        click($element offset(<onclick=w"*/Lead/MoveNext*">,0),"Left Click","No")
                        set(#isReady,$WaitForDetailPage(),"Global")
                    }
                    else {
                        log("No MoveNext button found while navigating to bottom - stopping")
                        set(#reachedEnd,"Yes","Global")
                    }
                }
            }
        }
    }
    log("Now positioned at the last record. Beginning processing from bottom to top.")
}
comment("*********************************************************-")
comment("************************* Click MoveNext ****************-")
comment("*********************************************************-")
define GoToNextRecord {
    if($exists(<onclick=w"*/Lead/MoveNext*">)) {
        then {
            log("Clicking MoveNext...")
            click($element offset(<onclick=w"*/Lead/MoveNext*">,0),"Left Click","No")
            set(#isReady,$WaitForDetailPage(60),"Global")
        }
        else {
            log("No MoveNext button found - stopping")
            set(#hasNext,"No","Global")
        }
    }
}
comment("*********************************************************-")
comment("************************* GoToPreviousRecord ****************-")
comment("*********************************************************-")
define GoToPreviousRecord {
    if($exists(<onclick=w"*/Lead/MovePrevious*">)) {
        then {
            log("Clicking MovePrevious...")
            click($element offset(<onclick=w"*/Lead/MovePrevious*">,0),"Left Click","No")
            set(#isReady,$WaitForDetailPage(60),"Global")
        }
        else {
            log("No MovePrevious button found - stopping")
            set(#hasNext,"No","Global")
        }
    }
}
comment("*********************************************************-")
comment("************************* AdvanceToNextRecord ****************-")
comment("*********************************************************-")
comment("--- Move in the appropriate direction based on #startAtBottom ---")
define AdvanceToNextRecord {
    log("Advancint to next record")
    if($comparison(#startAtBottom,"=","true")) {
        then {
            log("GotoPreviousRecord")
            GoToPreviousRecord()
        }
        else {
            log("GoToNextRecord")
            GoToNextRecord()
        }
    }
}
