clear all data
comment("===========================================")
comment("=== GLOBAL INIT ===")
comment("===========================================")
set(#skipGo,"false","Global")
set(#testMode,"true","Global")
set(#testName,"NAPOLEON RUSS","Global")
set(#smsCount,0,"Global")
clear list(%virtualAppointments)
clear list(%seenLeadIds)
clear list(%dayDates)
clear list(%dayBlocks)
clear list(%apptBlocks)
clear list(%parts)
clear list(%nameParts)
set(#goPressed,"false","Global")
set(#booked,0,"Global")
set(#failed,0,"Global")
comment("===========================================")
comment("=== PHASE 1: NAVIGATE + WAIT FOR GO ===")
comment("===========================================")
navigate("https://impact.ailife.com/Home/Index","Wait")
ui check box("Skip GO gate (dry run)",#skipGo)
ui check box("Test mode - only NAPOLEON RUSS",#testMode)
alert("Navigate to the first lead detail card and then press the 'GO' Button...")
comment("=== 1. Initialize the control variable ===")
set(#goPressed,"False","Global")
comment("=== 2. Create the 'Go' button ===")
comment("This button's job is just to flip the variable")
ui button("GO") {
    set(#goPressed,"True","Global")
    comment("You can add a ui stat monitor here to show it's ready if you like")
}
comment("=== 3. Pause logic: Loop until the variable is True ===")
loop while($comparison(#goPressed,"=","False")) {
    wait(1)
}
alert("GO received - starting scrape")
wait for element(<id="menucontainer">,30,"")
comment("===========================================")
comment("=== SCRAPE ===")
comment("===========================================")
set(#diagText,$scrape attribute(<id="menucontainer">,"outerhtml"),"Global")
save to file("C:\\ubot\\ubotSees.txt",#diagText)
alert("UBot sees {$text length(#diagText)} characters")
set(#pageText,$scrape attribute(<id="menucontainer">,"outerhtml"),"Global")
save to file("C:\\ubot\\rawPageText.txt",#pageText)
alert("About to Scrape The calendar - Length: {$text length(#pageText)}")
ScrapeCalendar()
alert("Scraped {$list total(%virtualAppointments)} virtual appointments")
SaveQueue()
comment("===========================================")
comment("=== PHASE 2: BOOK + SMS ===")
comment("===========================================")
