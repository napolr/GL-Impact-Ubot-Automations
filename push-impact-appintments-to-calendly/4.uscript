define ParseApptSpan {
    set(#apptKind,$replace regular expression(#spanText,"([A-Za-z ]+):.*","$1"),"Global")
    set(#apptTime,$replace regular expression(#spanText,".*:\\s*([0-9:]+\\s*[AP]M).*","$1"),"Global")
    set(#address,$replace regular expression(#spanText,".*[AP]M\\s*(.*?)\\s*H:.*","$1"),"Global")
}
define ParseDeleteLink {
    set(#apptId,$replace regular expression(#href,".*DeleteSchedule\\((\\d+),.*","$1"),"Global")
    set(#leadId,$replace regular expression(#href,".*,\\s*(\\d+),\\s*'LeadAppointment'.*","$1"),"Global")
    set(#dayIdx,$replace regular expression(#href,".*'LeadAppointment'\\s*,\\s*(\\d+)\\s*,.*","$1"),"Global")
    set(#apptType,$replace regular expression(#href,".*'LeadAppointment'\\s*,\\s*\\d+\\s*,\\s*'([^']+)'.*","$1"),"Global")
}
define IsVirtual {
    set(#isVirtualResult,"false","Global")
    if($contains($lower case(#apptType),"virtual")) {
        set(#isVirtualResult,"true","Global")
        then {
        }
        else {
        }
    }
}
