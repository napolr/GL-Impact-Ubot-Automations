alert("Get started")
clear all data
getTodayMarker()
set(#url,"https://mobile.impact.ailife.com/Lead/Inbox","Global")
navigate(#url,"Wait")
alert("Navigate to the first lead detail card and then press the 'GO' Button...")
click($element offset(<href=w"*InboxDetail*">,0),"Left Click","No")
comment("=== 1. Initialize the control variable ===")
comment("=== 4. Execution resumes here after the button is clicked ===")
alert("GO was pressed! Continuing with the script...")
comment("... your record processing loop goes here ...")
comment("Result example: 'Send Text on Sep 17 2026'")
set(#hasNext,"Yes","Global")
set(#count,0,"Global")
set(#maxLeads,100,"Global")
set(#firstLead,"true","Global")
comment("=== Main processing loop ===")
loop while($both($comparison(#hasNext,"=","Yes"),$comparison(#count,"<",#maxLeads))) {
    WaitForDetailPage()
    if($comparison(#firstLead,"=","false")) {
        then {
            click($element offset(<onclick=w"*/Lead/MoveNext*">,0),"Left Click","No")
        }
        else {
            set(#firstLead,"false","Global")
        }
    }
    set(#sendTextCompleted,"false","Global")
    comment("Get the lead information")
    run javascript("document.querySelector('#LeadTable tbody tr td a').click();")
    set(#pageData,$scrape attribute(<id="primaryPanel">,"innertext"),"Global")
    if($contains(#pageData,#todayMarker)) {
        then {
            comment("Text already sent today — skip this record")
            set(#skipRecord,"Yes","Global")
        }
        else {
            comment("=== Extract phone numbers ===")
            set(#mobileBlock,$page scrape("Mobile:","Home:"),"Global")
            set(#mobile,$trim($strip tags(#mobileBlock)),"Global")
            set(#homeBlock,$page scrape("Home:","Email:"),"Global")
            set(#home,$trim($strip tags($replace(#homeBlock,"Home:",""))),"Global")
            comment("Determine which phone number to use")
            if($comparison($trim(#mobile),"=","")) {
                then {
                    set(#primaryPhoneRaw,$trim(#home),"Global")
                }
                else {
                    set(#primaryPhoneRaw,$trim(#mobile),"Global")
                }
            }
            comment("=== URL-encode the phone number ===")
            set(#primaryPhoneEnc,#primaryPhoneRaw,"Global")
            set(#primaryPhoneEnc,$replace(#primaryPhoneEnc,"(","%28"),"Global")
            set(#primaryPhoneEnc,$replace(#primaryPhoneEnc,")","%29"),"Global")
            set(#primaryPhoneEnc,$replace(#primaryPhoneEnc," ","%20"),"Global")
            comment("=== Get leadid from the current URL ===")
            wait(2)
            set(#leadid,$replace($url,"https://mobile.impact.ailife.com/Lead/InboxDetail?LeadId=",""),"Global")
            comment("=== OPTION A: Click the actual Send Text link ===")
            click($element offset(<href=w"*CheckInSendText*">,0),"Left Click","No")
            wait(2)
            comment("--- Navigate to WhatHappend page and click Send Text ---")
            set(#url,"https://mobile.impact.ailife.com/Lead/WhatHappend?LeadId={#leadid}&PrimaryPhone={#primaryPhoneEnc}&callId=-2","Global")
            navigate(#url,"Wait")
            click($element offset(<onclick="SendText(); return false;">,0),"Left Click","No")
            wait(2)
            comment("--- Fallback: Call Back logic if Send Text fails ---")
            comment("=== CALL BACK LOGIC ===")
            set(#warnedUser,"false","Global")
            IsDetailPage()
            if($comparison(#onDetailPage,"=","false")) {
                then {
                    comment("SendTextFailed - try to automatically set callback")
                    scheduleCallBack()
                    if($comparison(#onDetailPage,"=","false")) {
                        then {
                            alert("Automated Disposition Setting Failed- Manually Chose Disposition to Proceed ")
                            TimedWaitForDetailPage(30)
                        }
                        else {
                            comment("Do Nothing")
                        }
                    }
                }
                else {
                    comment("Already warned user — staying silent")
                }
            }
        }
    }
    comment("=== Read the record counter ===")
    set(#counterText,$trim($strip tags($scrape attribute(<class="col-xs-3 text-center fbold pdrht0p">,"innertext"))),"Global")
    clear list(%counterParts)
    add list to list(%counterParts,$list from text(#counterText,"/"),"Delete","Global")
    set(#counterLeft,$trim($list item(%counterParts,0)),"Global")
    set(#counterRight,$trim($list item(%counterParts,1)),"Global")
    comment("Optional: Add logic here to set #hasNext = \"No\" when you reach the end")
    increment(#count)
}
define WaitForDetailPage {
    set(#attempts,0,"Local")
    set(#onDetailPage,"false","Global")
    loop while($comparison(#onDetailPage,"=","false")) {
        if($comparison(#attempts,">",60)) {
            then {
                alert("Timed out after 60 attempts waiting for Detail page")
                stop script
            }
        }
        increment(#attempts)
        wait(1)
        IsDetailPage()
    }
}
define IsDetailPage {
    set(#headerText,$scrape attribute(<class="container-fluid pgname">,"innertext"),"Local")
    set(#headerTextLowerCase,$change text casing($trim(#headerText),"Lower Case"),"Local")
    comment("Check both the header text and the URL")
    if($contains(#headerTextLowerCase,"detail")) {
        then {
            set(#onDetailPage,"true","Global")
        }
        else {
            set(#onDetailPage,"false","Global")
        }
    }
    return(#onDetailPage)
}
