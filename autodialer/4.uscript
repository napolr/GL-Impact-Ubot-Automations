define scheduleCallBack {
    set(#url,"https://mobile.impact.ailife.com/Lead/SetAppointment?appointmenttype=CallBack&leadid={#leadid}","Global")
    navigate(#url,"Wait")
    set(#url,"https://mobile.impact.ailife.com/Lead/SetAppointment?appointmenttype=CallBack&leadid={#leadid}&WorkflowProcessTypeId=3","Global")
    navigate(#url,"Wait")
    wait for browser event("Everything Loaded","")
    wait(3)
}
