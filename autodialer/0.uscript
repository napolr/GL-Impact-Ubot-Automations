include("C:\\projects\\UbotStudio Projects\\GL-Impact-Ubot-Automations\\library\\common-impact.ubot")
comment("=====================================================")
comment("=== MAIN ===")
comment("=====================================================")
clear all data
set(#todayMarker,$getTodayMarker(),"Global")
alert("Today's marker: {#todayMarker}")
comment("=== Navigate to Lead Inbox ===")
set(#url,"https://mobile.impact.ailife.com/Lead/Inbox","Global")
navigate(#url,"Wait")
wait for element(<div,id="leadContent">,"","Appear")
comment("=== Get total number of leads ===")
set(#maxLeads,$GetMaxLeads(),"Global")
alert("Total leads to process: {#maxLeads}")
comment("=== Open first lead ===")
wait for browser event("Everything Loaded","")
wait(2)
comment("=== Main processing loop ===")
set(#count,0,"Global")
set(#hasNext,"Yes","Global")
loop while($both($comparison(#count,"<",#maxLeads),$comparison(#hasNext,"=","Yes"))) {
    increment(#count)
    log("Processing record {#count} of {#maxLeads}")
    comment("=== 1. Wait for Detail page ===")
    set(#isReady,$WaitForDetailPage(60),"Global")
    if($comparison(#isReady,"=","false")) {
        then {
            alert("Detail page not found after 60 seconds. Stopping.")
            set(#hasNext,"No","Global")
        }
        else {
            comment("=== 2. Scrape this record ===")
            set(#pageData,$ScrapeRecord(),"Global")
            comment("=== 3. Skip check ===")
            set(#skipRecord,"No","Global")
            set(#todayStr,"{#monthAbbr} {#dayNum} {#yearNum}","Global")
            if($contains(#pageData,"No Answer on {#todayStr}")) {
                then {
                    set(#skipRecord,"Yes","Global")
                }
            }
            if($contains(#pageData,"Left Message on {#todayStr}")) {
                then {
                    set(#skipRecord,"Yes","Global")
                }
            }
            if($contains(#pageData,"Schedule Call Back appointment on")) {
                then {
                    set(#skipRecord,"Yes","Global")
                }
            }
            if($contains(#pageData,"Schedule Virtual Appointment")) {
                then {
                    set(#skipRecord,"Yes","Global")
                }
            }
            if($comparison(#skipRecord,"=","No")) {
                then {
                    comment("=== 4. Extract table fields (optional) ===")
                    set(#groupField,$GetTableValue("Group"),"Global")
                    set(#typeField,$GetTableValue("Type"),"Global")
                    set(#assignDate,$GetTableValue("AssignDate"),"Global")
                    set(#statusField,$GetTableValue("Status"),"Global")
                    log("Record {#count}: group={#groupField} type={#typeField} status={#statusField}")
                    comment("=== 5. Dial: mobile preferred, else home ===")
                    if($exists(<id="cellPhCallButton">)) {
                        then {
                            log("Clicking Call Mobile...")
                            click(<id="cellPhCallButton">,"Left Click","No")
                            wait(3)
                        }
                        else {
                            if($exists(<id="phoneCallButton">)) {
                                then {
                                    log("No mobile number - clicking Call Home...")
                                    click(<id="phoneCallButton">,"Left Click","No")
                                    wait(3)
                                }
                                else {
                                    alert("No Call Mobile or Call Home link found - skipping dial")
                                }
                            }
                        }
                    }
                    comment("=== 6. Wait for the user to disposition (up to 10 min) ===")
                    comment("The app returns to the Detail page automatically after disposition.")
                    set(#returned,$WaitForDetailPage(600),"Global")
                    if($comparison(#returned,"=","false")) {
                        then {
                            alert("Timed out after 10 minutes waiting for disposition - stopping")
                            set(#hasNext,"No","Global")
                        }
                    }
                }
                else {
                    log("Record {#count}: skipped (recent activity or future appointment)")
                }
            }
            comment("=== 7. Move to next record ===")
            if($both($comparison(#count,"<",#maxLeads),$comparison(#hasNext,"=","Yes"))) {
                then {
                    if($exists(<onclick=w"*/Lead/MoveNext*">)) {
                        then {
                            log("Clicking MoveNext...")
                            click($element offset(<onclick=w"*/Lead/MoveNext*">,0),"Left Click","No")
                            wait for browser event("Everything Loaded","")
                            wait(2)
                            set(#moved,$WaitForDetailPage(30),"Global")
                            if($comparison(#moved,"=","false")) {
                                then {
                                    alert("MoveNext failed to load a detail page - stopping")
                                    set(#hasNext,"No","Global")
                                }
                            }
                        }
                        else {
                            alert("No MoveNext button found - stopping")
                            set(#hasNext,"No","Global")
                        }
                    }
                }
            }
            comment("=== 8. End-of-list check via counter ===")
            set(#counterText,$trim($strip tags($scrape attribute(<class="col-xs-3 text-center fbold pdrht0p">,"innertext"))),"Global")
            clear list(%counterParts)
            add list to list(%counterParts,$list from text(#counterText,"/"),"Delete","Global")
            set(#counterLeft,$trim($list item(%counterParts,0)),"Global")
            set(#counterRight,$trim($list item(%counterParts,1)),"Global")
            if($both($comparison(#counterLeft,"=",#counterRight),$not($comparison(#counterLeft,"=","")))) {
                then {
                    alert("Reached end of list at record {#count}")
                    set(#hasNext,"No","Global")
                }
            }
        }
    }
}
alert("Script finished. Processed {#count} of {#maxLeads} leads.")
